# ============================================================================
# BarrioFix frontend: configuración
#
# Copiá este archivo a `.env` y completá los valores de tu cuenta de AWS:
#     cp .env.example .env
#
# Verificado contra la infra desplegada el 2026-09-04.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. VARIABLES DE BUILD  (se compilan DENTRO del bundle)
# ----------------------------------------------------------------------------
# Vite solo inyecta las variables que empiezan con VITE_, y lo hace en tiempo
# de BUILD, no en runtime. O sea: el valor queda escrito literalmente adentro
# de dist/assets/index-*.js.
#
# Si cambiás algo de acá, NO alcanza con volver a subir a S3:
# hay que correr `npm run build` de nuevo.
# ----------------------------------------------------------------------------

# DNS del Application Load Balancer que expone el backend (FastAPI).
# Sin barra final. HTTP, no HTTPS: el ALB escucha solo en el puerto 80.
#
# Cómo obtenerlo:
#   aws elbv2 describe-load-balancers \
#     --query "LoadBalancers[].{Nombre:LoadBalancerName,DNS:DNSName}" \
#     --output table
#   Consola: EC2 > Load Balancers > columna "DNS name"
#
# Verificá SIEMPRE que sea el ALB vivo antes de buildear:
#   curl http://<dns>/health     ->  tiene que devolver {"status":"ok"}
#
# Si devuelve 503, ese ALB no tiene targets healthy: es un problema de infra,
# no del frontend. Ojo que puede haber más de un ALB con nombre parecido y
# solo uno vivo.
VITE_API_URL=http://barriofix-alb-XXXXXXXXX.us-east-1.elb.amazonaws.com


# ----------------------------------------------------------------------------
# 2. VARIABLES DE DEPLOY  (NO entran al bundle)
# ----------------------------------------------------------------------------
# Estas no las lee la aplicación: no tienen prefijo VITE_, así que Vite las
# ignora. Están acá para documentar el destino del deploy y para poder
# copiarlas a los comandos de la sección de deploy del README.
# ----------------------------------------------------------------------------

# Región donde vive toda la infra del proyecto.
# Cómo obtenerla: es el segmento del medio en el DNS del ALB
# (barriofix-alb-123.<REGION>.elb.amazonaws.com), o `aws configure get region`.
AWS_REGION=us-east-1

# Nombre del bucket S3 que sirve el sitio estático (el destino del `aws s3 sync`).
# Cómo obtenerlo:
#   aws s3 ls
#   Consola: S3 > Buckets
AWS_S3_BUCKET=barriofix-frontend-clara

# URL pública del sitio: el WEBSITE endpoint del bucket de arriba.
#
# ⚠️ Tiene que ser el website endpoint, NO el REST endpoint. Son distintos:
#     website:  http://<bucket>.s3-website-us-east-1.amazonaws.com   <-- este
#     REST:     https://<bucket>.s3.amazonaws.com                    <-- NO
#   El REST endpoint no aplica el documento de error, así que las rutas del
#   router (/trabajos, /seguimiento, ...) dan 404 al recargar.
#
# ⚠️ Además, este valor tiene que coincidir CARÁCTER POR CARÁCTER con el
#   origen que el backend tiene en su lista de CORS, incluido el guión vs
#   punto en `s3-website-us-east-1` / `s3-website.us-east-1`. Ambas formas
#   existen en AWS pero son orígenes DISTINTOS para el browser.
#
# Cómo obtenerlo (copialo tal cual, no lo escribas a mano):
#   aws s3api get-bucket-website --bucket <bucket>
#   Consola: S3 > tu bucket > Properties > Static website hosting >
#            "Bucket website endpoint"
AWS_S3_WEBSITE_URL=http://barriofix-frontend-clara.s3-website-us-east-1.amazonaws.com

# Perfil de credenciales del AWS CLI a usar en el deploy.
# Dejalo vacío o borralo si usás el perfil por defecto.
# Cómo verlos: aws configure list-profiles
AWS_PROFILE=
